# ============================================================
# FWG-UltraEdge .gitignore — Audit v4.0
# ============================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/
jspm_packages/
bower_components/
web_modules/

# Build outputs
build/Release
dist/
.output
out/
.next/
.nuxt/

# TypeScript cache
*.tsbuildinfo

# Cache directories
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus/
.fusebox/
.dynamodb/
.firebase/
.grunt/
lib-cov/

# Package manager
.yarn-integrity
*.tgz
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# 🔐 Cloudflare — NEVER commit!
.dev.vars
.dev.vars.*
.wrangler/

# 🔐 Secrets — NEVER commit!
.env
.env.*
!.env.example
*.local

# Serverless
.serverless/

# Testing
.vscode-test

# Misc
.tern-port
.lock-wscript
.node_repl_history
