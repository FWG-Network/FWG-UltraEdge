{
  "name": "fwg-ultraedge",
  "version": "3.0.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bunx wrangler@4.93.1 deploy --dry-run --outdir dist --env \"\"",
    "dev": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "bun x prettier --write \"src/**/*.{ts,tsx,json}\"",
    "audit": "bun audit"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.57.0",
    "itty-router": "^5.0.24",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "bun-types": "^1.3.14",
    "esbuild": "0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.100.0"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.1"
  }
}